# Cloudflare D1 Configuration

# Toggle between Supabase and Cloudflare D1 for read operations
# Set to 'true' to use D1, 'false' to use Supabase
VITE_USE_D1=false

# Cloudflare Worker URL (your deployed Worker endpoint)
# Replace with your actual Worker URL after deployment
VITE_WORKER_URL=https://dripstech-api.YOUR-SUBDOMAIN.workers.dev
